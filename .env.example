# Public URLs
BASE_URL=https://your-domain.example
APP_BASE_URL=https://your-domain.example
REDIRECT_URI=https://your-domain.example/auth/google/callback
NODE_ENV=production

# Admin and Google OAuth
ADMIN_USERNAME=replace-me
ADMIN_PASSWORD=replace-with-a-long-random-password
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# Email notifications
RESEND_API_KEY=replace-me

# RustFS / S3-compatible object storage
S3_ENDPOINT=https://storage.your-domain.example
S3_REGION=us-east-1
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_BUCKET=replace-me
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=https://storage.your-domain.example

# Telegram bot
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_BOT_ADMIN_TOKEN=replace-with-a-long-random-token
TELEGRAM_ALLOWED_USER_IDS=123456789
